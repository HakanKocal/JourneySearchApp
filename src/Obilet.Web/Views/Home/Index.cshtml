@using System.Globalization
@using Microsoft.Extensions.Localization
@using Obilet.Application.Localization
@using Obilet.Web
@model JourneySearchViewModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Search_Title"].Value;
}

@*
    Arama formu. Bu adımda kalkış ve varış alanları düz açılır listelerdir;
    metin araması, takas butonu, tarih çipleri ve tasarım sonraki adımların
    işidir. Form POST ediliyor ve sonuç sayfasına yönlendirme yapılıyor,
    böylece sefer sayfası kendi paylaşılabilir adresine sahip oluyor.
*@

<h1 class="h4 mb-3">@L["Search_Title"]</h1>

@if (Model.Locations.Count == 0)
{
    <div class="alert alert-warning">@L["Search_NoLocations"]</div>
}
else
{
    <form asp-controller="Home" asp-action="Search" method="post" class="row g-3">
        <div class="col-12 col-md-4">
            <label asp-for="OriginId" class="form-label">@L["Search_Origin"]</label>
            <select asp-for="OriginId" class="form-select">
                @foreach (var location in Model.Locations)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-4">
            <label asp-for="DestinationId" class="form-label">@L["Search_Destination"]</label>
            <select asp-for="DestinationId" class="form-select">
                @foreach (var location in Model.Locations)
                {
                    <option value="@location.Id">@location.Name</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-4">
            <label asp-for="DepartureDate" class="form-label">@L["Search_Date"]</label>
            @*
                Tarayıcının yerel tarih seçicisi kullanılıyor. type="date"
                her zaman ISO biçimi (yyyy-MM-dd) gönderir, dolayısıyla
                kültüre bağlı ayrıştırma sorunu oluşmaz.
            *@
            <input asp-for="DepartureDate" type="date" class="form-control"
                   value="@Model.DepartureDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">@L["Search_Submit"]</button>
        </div>
    </form>
}

@*
    Kültür eşlemesinin çalıştığını gözle doğrulanabilir kılan geçici tanı
    satırı. Tasarım adımında kaldırılacak.
*@
<p class="small text-secondary mt-4">
    @L["Culture_Current"]: <code>@CultureInfo.CurrentUICulture.Name</code>
    &middot;
    @L["Culture_MarketLocale"]: <code>@MarketLocale.FromCulture(CultureInfo.CurrentUICulture)</code>
</p>
