@using System.Globalization
@using Microsoft.Extensions.Localization
@using Obilet.Web
@using Obilet.Web.Formatting
@model JourneyListViewModel
@inject IStringLocalizer<SharedResource> L
@{
    var originLabel = Model.OriginName ?? Model.OriginId.ToString();
    var destinationLabel = Model.DestinationName ?? Model.DestinationId.ToString();

    ViewData["Title"] = $"{originLabel} - {destinationLabel}";

    // Gece yarısını aşan seferlerin başladığı sıra. Liste kronolojik olduğu
    // için bu seferler sonda toplanır ve araya bir ayırıcı konur.
    var nextDayIndex = Model.FirstNextDayIndex;

    // Karttaki form alanları için ISO tarihler. type="date" ve istemci
    // tarafı karşılaştırmalar kültürden bağımsız biçim istiyor.
    var todayIso = Model.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var tomorrowIso = Model.Today.AddDays(1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var selectedIso = Model.DepartureDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    // Hızlı tarih çipleri. Kimlikler ana sayfadakilerle aynı: alanların
    // davranışı iki sayfada aynı dosyadan geliyor ve o dosya kimliklere
    // göre bağlanıyor.
    var chips = new[]
    {
        (ElementId: "chip-today", Iso: todayIso, Label: L["Search_Today"].Value),
        (ElementId: "chip-tomorrow", Iso: tomorrowIso, Label: L["Search_Tomorrow"].Value),
    };
}

@*
    Sefer listesi. Verilen tasarım izleniyor: fotoğraf zeminli kısa bir hero,
    üzerine binen arama kartı, ve her seferi tek satırda gösteren yatay
    kartlar. Tasarımda o kart yalnızca sorguyu özetliyordu; burada gerçek
    bir form, gerekçesi kartın kendi yorumunda.
*@

@section Hero {
    <section class="hero hero--list">
        <div class="hero-media"></div>
        <div class="hero-veil"></div>

        <div class="container hero-inner">
            <div class="hero-topline">
                <a asp-controller="Home" asp-action="Index" class="pill-back">
                    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left" /></svg>
                    @L["Journey_BackHome"]
                </a>

                <div class="hero-lang">
                    <partial name="_LanguageSwitcher" />
                </div>
            </div>

            <div class="hero-content">
                @*
                    Sayfanın h1'i güzergâh değil sayfanın kendisi; güzergâh
                    hemen altındaki özet kartında ve belge başlığında yer
                    alıyor. Tasarımdaki başlık da bu.
                *@
                <h1 class="hero-title">@L["Journey_PageTitle"]</h1>
                <p class="hero-lead">@L["Journey_PageLead"]</p>
            </div>
        </div>

        <svg class="hero-curve" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 64V18C200 0 420 6 720 22c300 16 520 22 720 14v28z" fill="currentColor" stroke="none" />
        </svg>
    </section>
}

<div class="journey-page">
    <div class="container">
        @*
            Sorgu özeti ve yeni arama, aynı kart.

            Tasarımda bu kart arama alanlarına benzeyen ama yalnızca değer
            gösteren bir şeritti. Burada gerçek bir form: kullanıcı sonuçları
            görürken başka bir Bus Location veya Departure Date seçip yeniden
            sorgulayabiliyor, yani güzergâhı değiştirmek için ana sayfaya
            dönmek gerekmiyor. Gerekçe ve ödünleşmeler docs/adr/0010'da.

            Alanlar ana sayfanın kartıyla aynı işaretlemeyi ve aynı
            `.search-fields` ızgarasını kullanıyor; davranışları da aynı
            partial'dan geliyor (_SearchFieldsScripts). Tek fark başlangıç
            değerinin kaynağı: burada adres, ana sayfada depo.

            Form ana sayfanın `Search` eylemine gidiyor: o eylem doğrulamayı
            yapıp sefer sayfasına yönlendirdiği için ayrı bir uç noktaya
            gerek yok. Alanlar düz `select` ve `input` olduğu için gönderim
            JavaScript kapalıyken de çalışıyor; çipler ve takas düğmesi ise
            çalışmıyor, gerekçesi ADR'de.
        *@
        <form asp-controller="Home" asp-action="Search" method="post"
              class="summary-card" id="search-form" novalidate>

            @*
                Yalnızca istemci tarafı doğrulama buraya yazıyor, o yüzden
                gizli başlıyor.

                Sunucu doğrulaması bu kutuyu hiç kullanmıyor: `Search`
                eylemi hatalı sorguda ana sayfanın formunu döndürüyor ve
                hata orada gösteriliyor. Yani JavaScript kapalıyken geçersiz
                bir sorgu kullanıcıyı listeden ana sayfaya taşıyor. Bilinen
                bir pürüz; bkz. README "Bilinen sınırlar".
            *@
            <div id="validation-summary" class="alert alert-danger d-none"></div>

            <div class="search-fields">
                <div class="field-card">
                    <svg class="icon" aria-hidden="true"><use href="#icon-pin" /></svg>
                    <div class="field-body">
                        <label class="field-label" for="origin">@L["Search_Origin"]</label>
                        <select name="OriginId" id="origin" data-location-select>
                            @*
                                Sorgulanan lokasyon varsayılan listede olmayabilir
                                (bkz. docs/adr/0004): kullanıcı onu arama yoluyla
                                seçmiş olabilir. Seçenek eklenmezse tarayıcı seçimi
                                ilk kayda kaydırır ve kullanıcı formu açtığında
                                aradığı güzergâh yerine başka bir şey görürdü.
                            *@
                            @if (!Model.IsListed(Model.OriginId))
                            {
                                <option value="@Model.OriginId" selected>@originLabel</option>
                            }
                            @foreach (var location in Model.Locations)
                            {
                                <option value="@location.Id"
                                        selected="@(location.Id == Model.OriginId)">@location.Name</option>
                            }
                        </select>
                    </div>
                    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg>
                </div>

                <button type="button" class="swap-button" id="swap"
                        title="@L["Journey_SwapDirection"]" aria-label="@L["Journey_SwapDirection"]">
                    <svg class="icon" aria-hidden="true"><use href="#icon-swap" /></svg>
                </button>

                <div class="field-card">
                    <svg class="icon" aria-hidden="true"><use href="#icon-pin" /></svg>
                    <div class="field-body">
                        <label class="field-label" for="destination">@L["Search_Destination"]</label>
                        <select name="DestinationId" id="destination" data-location-select>
                            @if (!Model.IsListed(Model.DestinationId))
                            {
                                <option value="@Model.DestinationId" selected>@destinationLabel</option>
                            }
                            @foreach (var location in Model.Locations)
                            {
                                <option value="@location.Id"
                                        selected="@(location.Id == Model.DestinationId)">@location.Name</option>
                            }
                        </select>
                    </div>
                    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg>
                </div>

                <div class="field-card">
                    <svg class="icon" aria-hidden="true"><use href="#icon-calendar" /></svg>
                    <div class="field-body">
                        <label class="field-label" for="departure-date">@L["Search_Date"]</label>
                        @*
                            type="date" her zaman ISO biçimi gönderir, bu yüzden
                            kültüre bağlı ayrıştırma sorunu oluşmaz. min özniteliği
                            tarayıcı seviyesinde geçmiş tarihi engeller; aynı kural
                            sunucuda da uygulanıyor, çünkü bu yalnızca bir kolaylık.
                        *@
                        <input type="date" name="DepartureDate" id="departure-date"
                               class="field-value" min="@todayIso" value="@selectedIso" />
                    </div>
                </div>
            </div>

            <div class="summary-actions">
                @* Çipler tarih alanını ayarlıyor; ana sayfadakiyle aynı davranış. *@
                <div class="summary-chips">
                    @foreach (var chip in chips)
                    {
                        <button type="button" class="date-chip" id="@chip.ElementId"
                                data-date="@chip.Iso">
                            <svg class="icon" aria-hidden="true"><use href="#icon-calendar" /></svg>
                            @chip.Label
                        </button>
                    }
                </div>

                <button type="submit" class="btn-obilet btn-obilet--compact">
                    <svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg>
                    @L["Search_Submit"]
                </button>
            </div>
        </form>

        @if (Model.IsEmpty)
        {
            @* Boş sonuç bir hata değil: normal bir cevap olarak sunulur. *@
            <div class="state-card">
                <div class="state-title">@L["Journey_Empty"]</div>
                <div class="small">@L["Journey_EmptyHint"]</div>
                <a asp-controller="Home" asp-action="Index" class="btn-obilet btn-obilet--auto mt-3">
                    @L["Journey_BackHome"]
                </a>
            </div>
        }
        else
        {
            <div class="list-toolbar">
                <p class="list-count">@L["Journey_CountFormat", Model.Journeys.Count]</p>

                @*
                    Sıralama istemci tarafında yapılıyor: liste zaten tamamen
                    sayfada ve yeniden sorgulamak API'ye gereksiz bir istek
                    olurdu. Varsayılan sıra kalkış anına göre artan ve bu
                    sunucuda kuruluyor; açılır liste yalnızca gösterimi
                    değiştiriyor, dolayısıyla JavaScript kapalıyken de liste
                    doğru sırada geliyor.
                *@
                <label class="sort-field" for="journey-sort">
                    <svg class="icon" aria-hidden="true"><use href="#icon-sort" /></svg>
                    <span class="visually-hidden">@L["Journey_Sort"]</span>
                    <select id="journey-sort">
                        <option value="departure">@L["Journey_SortDeparture"]</option>
                        <option value="price">@L["Journey_SortPrice"]</option>
                        <option value="duration">@L["Journey_SortDuration"]</option>
                    </select>
                    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg>
                </label>
            </div>

            <div id="journey-list">
                @for (var index = 0; index < Model.Journeys.Count; index++)
                {
                    var journey = Model.Journeys[index];

                    @if (nextDayIndex == index)
                    {
                        @*
                            Ayırıcı yalnızca kronolojik sırada anlam taşıyor;
                            fiyata veya süreye göre sıralandığında istemci
                            tarafı onu gizliyor.
                        *@
                        <div class="next-day-divider" data-next-day-divider>
                            @L["Journey_NextDayFormat", journey.Departure.ToString("d MMMM, dddd")]
                        </div>
                    }

                    // Süre biçimlendirmesi ayrı bir yerde: gün bileşenini
                    // düşüren h:mm biçimi 25 saatlik bir seferi 1:30
                    // olarak gösteriyordu.
                    var duration = DurationFormatter.Format(journey.Duration);

                    // Sıralama anahtarları kültürden bağımsız biçimde
                    // yazılıyor: istemci bunları sayı olarak okuyor ve
                    // Türkçe kültürde ondalık ayırıcı virgül olurdu.
                    var sortPrice = journey.InternetPrice.ToString(CultureInfo.InvariantCulture);
                    var sortDuration = journey.Duration is null
                        ? string.Empty
                        : ((long)journey.Duration.Value.TotalMinutes).ToString(CultureInfo.InvariantCulture);

                    <article class="journey-card" data-journey
                             data-departure="@journey.Departure.ToString("s", CultureInfo.InvariantCulture)"
                             data-price="@sortPrice"
                             data-duration="@sortDuration">

                        @*
                            Saatler/nitelikler ile terminaller iki ayrı ızgara
                            öğesi. Bir sarmalayıcı içinde de durabilirlerdi ama o
                            zaman dar ekranda ikisi birlikte fiyatla aynı satırı
                            paylaşmak zorunda kalıyor ve kolona 202px kalıyordu;
                            ölçüm için bkz. obilet.css. Ayrı öğe olunca dar
                            ekranda saatler kartın tam genişliğini alıyor,
                            fiyat terminallerin yanına iniyor.
                        *@
                        <div class="journey-times">
                            <div>
                                <div class="journey-time-label">@L["Journey_Departure"]</div>
                                <div class="journey-time">@journey.Departure.ToString("HH:mm")</div>
                            </div>

                            <span class="journey-arrow">
                                <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right" /></svg>
                            </span>

                            <div>
                                <div class="journey-time-label">@L["Journey_Arrival"]</div>
                                <div class="journey-time">@journey.Arrival.ToString("HH:mm")</div>
                            </div>

                            @if (duration is not null)
                            {
                                <div class="journey-spec">
                                    <div class="journey-time-label">@L["Journey_Duration"]</div>
                                    <div class="journey-spec-value">@duration</div>
                                </div>
                            }

                            @*
                                Koltuk düzeni (2+1, 2+2). Süreyle aynı desende
                                çiziliyor çünkü ikisi de seferin sabit bir
                                niteliği — olanaklar gibi opsiyonel bir donanım
                                değil. Yanındaki koltuk ikonu, "2+1" gibi kendi
                                başına anlamı olmayan bir değeri bağlamına
                                oturtuyor.

                                API bu alanı bildirmeyebiliyor; o zaman hücre
                                hiç çizilmiyor, boş bir etiket görünmüyor.
                            *@
                            @if (!string.IsNullOrWhiteSpace(journey.BusType))
                            {
                                <div class="journey-spec"
                                     title="@L["Journey_SeatLayoutTitleFormat", journey.BusType]">
                                    <div class="journey-time-label">@L["Journey_SeatLayout"]</div>
                                    <div class="journey-spec-value journey-seat">
                                        <svg class="icon" aria-hidden="true"><use href="#icon-seat" /></svg>
                                        @journey.BusType
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="journey-stations">
                            <span class="journey-station">
                                <svg class="icon" aria-hidden="true"><use href="#icon-pin" /></svg>
                                <span title="@journey.OriginStation">@journey.OriginStation</span>
                            </span>
                            <span>&ndash;</span>
                            <span class="journey-station">
                                <svg class="icon" aria-hidden="true"><use href="#icon-pin" /></svg>
                                <span title="@journey.DestinationStation">@journey.DestinationStation</span>
                            </span>
                        </div>

                        @*
                            Olanaklar: varsa tanıtım etiketi üstte, ikonlar altta.

                            Kolon, olanak olmayan seferlerde de boş olarak
                            duruyor: ızgara izi kaybolsa kartların kolonları
                            listede birbirinden kayardı. Ama `role` ve etiket
                            yalnızca içerik varken veriliyor — boş bir grubu
                            "Olanaklar" diye duyurmak ekran okuyucu için
                            gürültüden başka bir şey değil.
                        *@
                        <div class="journey-features"
                             role="@(journey.Features.Count > 0 ? "group" : null)"
                             aria-label="@(journey.Features.Count > 0 ? L["Journey_Features"].Value : null)">
                            @foreach (var feature in journey.Features.Where(f => f.IsPromoted))
                            {
                                @*
                                    Tanıtımlı olanaklar metin etiketi olarak:
                                    taşıdıkları bilgi çoğunlukla bir indirim
                                    tutarı ve bir sembole sığmaz. Renkler
                                    API'den geldiği için yazılmadan önce
                                    doğrulanır; bkz. CssColor.
                                *@
                                var background = CssColor.Sanitize(feature.BackgroundColor);
                                var foreground = CssColor.Sanitize(feature.ForegroundColor);
                                var style = string.Concat(
                                    background is null ? string.Empty : $"background-color:{background};",
                                    foreground is null ? string.Empty : $"color:{foreground};");

                                <span class="journey-feature-badge" style="@style"
                                      title="@feature.Name">@feature.Name</span>
                            }

                            @{
                                var iconFeatures = journey.Features.Where(f => !f.IsPromoted).ToList();
                            }
                            @if (iconFeatures.Count > 0)
                            {
                                @*
                                    Olanakların tamamı gösteriliyor, kırpma yok.
                                    Önceki hâlinde dört öğelik bir kapak vardı ve
                                    tanıtım etiketi de aynı slotları paylaştığı için
                                    indirim kodu olan bir sefer komşusundan bir ikon
                                    az gösteriyordu. Kapağı kaldırmanın ölçülen
                                    maliyeti ağ üzerinde 570 bayt; bkz. Journey.
                                *@
                                <div class="journey-feature-icons">
                                    @foreach (var feature in iconFeatures)
                                    {
                                        @*
                                            İkon her kimlik için mevcut değil ve olmayan
                                            kimlik 403 döndürüyor; yüklenemeyen ikon
                                            gizlenir, adı erişilebilir hâlde kalır.

                                            Ad hem `alt` hem `title` olarak veriliyor:
                                            ikonun kendisi ne olduğunu anlatmıyor, bu
                                            yüzden üzerine gelince adı görünmeli.
                                        *@
                                        <img class="journey-feature-icon" data-feature-icon
                                             src="@FeatureIcon.UrlFor(feature.Id)"
                                             alt="@feature.Name" title="@feature.Name"
                                             width="18" height="18" loading="lazy" />
                                    }
                                </div>
                            }
                        </div>

                        <div class="journey-partner">
                            <span class="journey-partner-name">@journey.PartnerName</span>
                            @*
                                Logo bir CDN üzerinde ve her firma için mevcut
                                olduğu garanti değil; yüklenemezse gizlenir ve
                                firma adı yazıyla kalır.
                            *@
                            <img class="journey-partner-logo" data-partner-logo
                                 src="@PartnerLogo.UrlFor(journey.PartnerId)"
                                 alt="@journey.PartnerName" loading="lazy" />
                        </div>

                        <div class="journey-price">
                            @*
                                Sayı biçimi kültürden, para birimi API'nin bildirdiği
                                koddan gelir. ToString("C2") kullanılmaz: İngilizce
                                arayüzde Türk Lirası tutarını dolar olarak gösterirdi.
                            *@
                            <span class="price-badge">
                                @MoneyFormatter.Format(journey.InternetPrice, journey.Currency)
                            </span>

                            @if (journey.HasDiscount)
                            {
                                @* Yalnızca gerçek indirim varsa çizili fiyat gösterilir. *@
                                <div class="price-original">
                                    @MoneyFormatter.Format(journey.OriginalPrice, journey.Currency)
                                </div>
                            }
                        </div>

                        @*
                            Seçim düğmesi tasarımda var ama koltuk seçimi ve
                            satın alma bu uygulamanın kapsamı dışında. Görsel
                            olarak tasarımdaki hâliyle duruyor; devre dışı
                            olduğu hem `disabled` ile hem açıklamayla belli.
                            Çalışıyormuş gibi görünen bir düğme koymak
                            kullanıcıya yanlış bilgi verirdi.
                        *@
                        <button type="button" class="journey-select" disabled
                                title="@L["Journey_SelectUnavailable"]">
                            @L["Journey_Select"]
                            <svg class="icon" aria-hidden="true"><use href="#icon-chevron-right" /></svg>
                        </button>
                    </article>
                }
            </div>
        }
    </div>
</div>

@section Styles {
    @* Aranabilir açılır liste; özet kartındaki lokasyon alanları için. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css" />
}

@section Scripts {
    @*
        Karttaki arama alanları. Ana sayfayla aynı partial, aynı kimlikler;
        tek fark son aramanın geri yüklenmemesi.

        Bu sayfanın başlangıç değeri adresin kendisi. Depodan okumak,
        adreste yazan güzergâhla çelişen bir form üretirdi — kullanıcı
        Ankara'nın seferlerine bakarken formda İzmir görürdü. Gönderimde
        depoya yine yazılıyor.
    *@
    <partial name="_SearchFieldsScripts"
             model="new SearchFieldsScripts(
                 Today: Model.Today,
                 RestoreLastSearch: false)" />

    <script src="~/js/journey-list.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Yüklenemeyen firma logolarını ve olanak ikonlarını gizler. Inline
            // onerror yerine burada bağlanıyor; işaretleme temiz kalsın.
            //
            // Olmayan bir olanak ikonu 404 değil 403 döndürüyor, bu yüzden
            // durum koduna bakılamaz; tarayıcının hata olayı tek güvenilir yol.
            const images = document.querySelectorAll('[data-partner-logo], [data-feature-icon]');
            for (const image of images) {
                image.addEventListener('error', function () {
                    image.style.display = 'none';
                });
            }

            const helpers = window.ObiletJourneyList;
            const list = document.getElementById('journey-list');
            const sort = document.getElementById('journey-sort');
            if (helpers && list && sort) {
                helpers.attachSorting(list, sort);
            }
        })();
    </script>
}
