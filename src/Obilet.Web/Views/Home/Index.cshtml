@using System.Globalization
@using Microsoft.Extensions.Localization
@using Obilet.Application.Locations
@using Obilet.Web
@model JourneySearchViewModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Search_Title"].Value;

    var today = Model.Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var tomorrow = Model.Today.AddDays(1).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var selectedDate = Model.DepartureDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var minQueryLength = ILocationService.MinimumQueryLength;

    // Olanak şeridi: dört maddenin ikonu ve metin anahtarları birlikte
    // duruyor, böylece işaretleme dört kez tekrarlanmıyor.
    var valueItems = new[]
    {
        (Icon: "shield", Title: "Home_Value1_Title", Text: "Home_Value1_Text"),
        (Icon: "seat", Title: "Home_Value2_Title", Text: "Home_Value2_Text"),
        (Icon: "clock", Title: "Home_Value3_Title", Text: "Home_Value3_Text"),
        (Icon: "headset", Title: "Home_Value4_Title", Text: "Home_Value4_Text"),
    };
}

@section Styles {
    @* Aranabilir açılır liste. Kendi autocomplete'ini yazmak klavye
       gezinmesi, ARIA rolleri, dışa tıklama ve yarış koşulları demek;
       bunları doğru yapmak bu ödevin kapsamına göre orantısız. *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css" />
}

@section Hero {
    <section class="hero hero--home">
        @* Fotoğraf ve mavi perde ayrı katmanlar; gerekçe obilet.css içinde. *@
        <div class="hero-media"></div>
        <div class="hero-veil"></div>

        <div class="container hero-inner">
            <div class="hero-topline">
                <span class="hero-brand">
                    <svg class="icon" aria-hidden="true"><use href="#icon-bus" /></svg>
                    <span class="hero-brand-rule"></span>
                    <span>@L["Home_Eyebrow"]</span>
                </span>

                <div class="hero-lang">
                    <partial name="_LanguageSwitcher" />
                </div>
            </div>

            <div class="hero-content">
                <h1 class="hero-title">
                    <span>@L["Home_TitleLine1"]</span>
                    <span class="hero-title-soft">@L["Home_TitleLine2"]</span>
                </h1>

                <p class="hero-lead">@L["Home_Lead"]</p>
            </div>

            <div class="search-card">
                @if (Model.Locations.Count == 0)
                {
                    <div class="alert alert-warning mb-0">@L["Search_NoLocations"]</div>
                }
                else
                {
                    @*
                        Doğrulama özeti. Sunucudan hata geldiyse görünür başlar;
                        aksi hâlde gizli durur ve istemci tarafı ayna doğrulama açar.
                    *@
                    <div asp-validation-summary="All" id="validation-summary"
                         class="alert alert-danger @(ViewData.ModelState.IsValid ? "d-none" : string.Empty)"></div>

                    @* Kaydedilmiş tarih eskimişse kullanıcıya bilgi verilir; değer
                       sessizce altından değiştirilmez. *@
                    <div class="alert alert-info d-none" id="date-adjusted-notice">@L["Search_DateAdjusted"]</div>

                    <form asp-controller="Home" asp-action="Search" method="post" id="search-form" novalidate>
                        @* Tarih çipleri kartın üstünde; tasarımdaki yerleşim bu. *@
                        <div class="date-chips">
                            <button type="button" class="date-chip" id="chip-today" data-date="@today">
                                <svg class="icon" aria-hidden="true"><use href="#icon-calendar" /></svg>
                                @L["Search_Today"]
                            </button>
                            <button type="button" class="date-chip" id="chip-tomorrow" data-date="@tomorrow">
                                <svg class="icon" aria-hidden="true"><use href="#icon-calendar" /></svg>
                                @L["Search_Tomorrow"]
                            </button>
                        </div>

                        @*
                            Kalkış, takas, varış ve tarih. Dar ekranda dikey yığılı
                            ve takas butonu ilk iki alanın dikişinde; geniş ekranda
                            dördü tek satırda. Bkz. .search-fields.
                        *@
                        <div class="search-fields">
                            <div class="field-card">
                                <svg class="icon" aria-hidden="true"><use href="#icon-pin" /></svg>
                                <div class="field-body">
                                    <label asp-for="OriginId" class="field-label">@L["Search_Origin"]</label>
                                    <select asp-for="OriginId" id="origin" data-location-select>
                                        @foreach (var location in Model.Locations)
                                        {
                                            <option value="@location.Id">@location.Name</option>
                                        }
                                    </select>
                                </div>
                                <svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg>
                            </div>

                            <button type="button" class="swap-button" id="swap"
                                    title="@L["Search_Swap"]" aria-label="@L["Search_Swap"]">
                                <svg class="icon" aria-hidden="true"><use href="#icon-swap" /></svg>
                            </button>

                            <div class="field-card">
                                <svg class="icon" aria-hidden="true"><use href="#icon-pin" /></svg>
                                <div class="field-body">
                                    <label asp-for="DestinationId" class="field-label">@L["Search_Destination"]</label>
                                    <select asp-for="DestinationId" id="destination" data-location-select>
                                        @foreach (var location in Model.Locations)
                                        {
                                            <option value="@location.Id">@location.Name</option>
                                        }
                                    </select>
                                </div>
                                <svg class="icon" aria-hidden="true"><use href="#icon-chevron-down" /></svg>
                            </div>

                            <div class="field-card">
                                <svg class="icon" aria-hidden="true"><use href="#icon-calendar" /></svg>
                                <div class="field-body">
                                    <label asp-for="DepartureDate" class="field-label">@L["Search_Date"]</label>
                                    @*
                                        type="date" her zaman ISO biçimi gönderir, bu yüzden
                                        kültüre bağlı ayrıştırma sorunu oluşmaz. min özniteliği
                                        tarayıcı seviyesinde geçmiş tarihi engeller; aynı kural
                                        sunucuda da uygulanıyor, çünkü bu yalnızca bir kolaylık.
                                    *@
                                    <input asp-for="DepartureDate" type="date" id="departure-date"
                                           class="field-value" min="@today" value="@selectedDate" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-1">
                            <span asp-validation-for="OriginId" class="text-danger small"></span>
                            <span asp-validation-for="DestinationId" class="text-danger small"></span>
                            <span asp-validation-for="DepartureDate" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn-obilet">
                            <svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg>
                            @L["Search_Submit"]
                        </button>
                    </form>
                }
            </div>
        </div>

        @* Hero'nun alt kenarındaki beyaz kıvrım; gerekçe obilet.css içinde. *@
        <svg class="hero-curve" viewBox="0 0 1440 64" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 64V18C200 0 420 6 720 22c300 16 520 22 720 14v28z" fill="currentColor" stroke="none" />
        </svg>
    </section>
}

@* Hero'nun altındaki dört maddelik şerit. *@
<section class="value-strip" aria-label="@L["Home_ValueStrip"]">
    <div class="container">
        <div class="value-grid">
            @foreach (var item in valueItems)
            {
                <div class="value-item">
                    <span class="value-badge">
                        <svg class="icon" aria-hidden="true"><use href="#icon-@item.Icon" /></svg>
                    </span>
                    <div class="value-title">@L[item.Title]</div>
                    <p class="value-text">@L[item.Text]</p>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
    <script src="~/js/search-form.js" asp-append-version="true"></script>
    <script>
        (function () {
            const helpers = window.ObiletSearchForm;

            const config = {
                minQueryLength: @minQueryLength,
                searchUrl: '@Url.Action("Search", "Locations")',
                today: '@today',
                tomorrow: '@tomorrow',
                messages: {
                    noResults: @Html.Raw(Json.Serialize(L["Search_NoResults"].Value)),
                    typeMore: @Html.Raw(Json.Serialize(L["Search_TypeMoreFormat", minQueryLength].Value)),
                    placeholder: @Html.Raw(Json.Serialize(L["Search_Placeholder"].Value)),
                    sameLocation: @Html.Raw(Json.Serialize(L["Validation_SameLocation"].Value)),
                    pastDate: @Html.Raw(Json.Serialize(L["Validation_PastDate"].Value))
                }
            };

            const form = document.getElementById('search-form');
            if (!form || !helpers) return;

            const origin = document.getElementById('origin');
            const destination = document.getElementById('destination');
            const date = document.getElementById('departure-date');
            const summary = document.getElementById('validation-summary');
            const notice = document.getElementById('date-adjusted-notice');
            const chips = {
                today: document.getElementById('chip-today'),
                tomorrow: document.getElementById('chip-tomorrow')
            };

            // --- Aranabilir lokasyon alanları --------------------------------
            function createLocationSelect(element) {
                // Sunucunun geçerli terim için döndürdüğü kimlikler. Ayrı
                // tutulması zorunlu: sunucu eşleşmelerinin bir kısmı API'nin
                // anahtar kelime alanından geliyor ve istemci o alanı görmüyor.
                // Örneğin "esenler" araması "İstanbul Avrupa" döndürüyor;
                // yalnızca ada bakan bir süzgeç bu sonucu elerdi.
                //
                // Küme, geldiği terimle birlikte tutuluyor. Bunu bir kod
                // incelemesi ortaya çıkardı: yalnızca kimlikleri saklamak,
                // önceki aramanın sonuçlarının sonraki terimde de eşleşme
                // sayılmasına yol açıyordu — "kadikoy" araması İstanbul
                // Anadolu döndürdükten sonra "iz" yazıldığında o kayıt
                // listede kalıyordu. Minimum uzunluğun altındaki terimlerde
                // istek hiç atılmadığı için küme kendiliğinden de sıfırlanmıyordu.
                let remoteMatches = { query: null, ids: new Set() };

                return new TomSelect(element, {
                    valueField: 'id',
                    labelField: 'name',
                    searchField: ['name'],
                    maxOptions: 20,
                    create: false,
                    placeholder: config.messages.placeholder,
                    // Tom Select'in yerleşik gecikmesi; her tuşta istek atmaz.
                    loadThrottle: 300,

                    // Kullanıcı yazmaya başladığında seçili değer gizleniyor.
                    //
                    // Sebebi: Tom Select tek seçimli alanlarda seçili öğeyi
                    // kontrolde bırakıyor ve yazılan metni onun yanına
                    // ekliyor, dolayısıyla "Ankara" ile "rize" yan yana
                    // görünüyordu. Gizleme CSS'te, `has-typed` sınıfına bağlı.
                    //
                    // Neden odaklanmada değil de yazmaya başlayınca: alana
                    // dokunan kullanıcı henüz bir şey yazmadıysa mevcut
                    // seçimini görmeye devam etmeli. Yer tutucuya yazmak
                    // denendi ve işe yaramadı — Tom Select odaklanmada kendi
                    // `updatePlaceholder` çağrısıyla üzerine yazıyor.
                    //
                    // Değer gizlenirken silinmiyor: silmek daha basit olurdu
                    // ama seçim yapmadan alandan çıkan kullanıcıyı boş bir
                    // alanla bırakırdı.
                    onType: function (text) {
                        this.wrapper.classList.toggle(
                            'has-typed', String(text || '').length > 0);
                    },

                    onBlur: function () {
                        this.wrapper.classList.remove('has-typed');
                    },

                    onChange: function () {
                        this.wrapper.classList.remove('has-typed');
                    },

                    score: function (search) {
                        const needle = helpers.foldTurkish(search);

                        // Sunucu sonuçları yalnızca geldikleri terim için
                        // geçerli; terim değiştiyse yok sayılırlar.
                        const trusted = remoteMatches.query === needle
                            ? remoteMatches.ids
                            : null;

                        return function (item) {
                            if (!needle) return 1;
                            if (trusted !== null && trusted.has(String(item.id))) return 1;

                            return helpers.foldTurkish(item.name).indexOf(needle) !== -1 ? 1 : 0;
                        };
                    },

                    shouldLoad: function (query) {
                        return query.trim().length >= config.minQueryLength;
                    },

                    load: function (query, callback) {
                        fetch(config.searchUrl + '?q=' + encodeURIComponent(query), {
                            headers: { 'Accept': 'application/json' }
                        })
                            .then(function (response) {
                                return response.ok ? response.json() : [];
                            })
                            .then(function (results) {
                                remoteMatches = {
                                    query: helpers.foldTurkish(query),
                                    ids: new Set(results.map(function (item) {
                                        return String(item.id);
                                    }))
                                };
                                callback(results);
                            })
                            // Ağ hatası açılır listeyi kilitlememeli.
                            .catch(function () {
                                remoteMatches = { query: null, ids: new Set() };
                                callback();
                            });
                    },

                    render: {
                        no_results: function (data) {
                            const text = data.input.trim().length < config.minQueryLength
                                ? config.messages.typeMore
                                : config.messages.noResults;
                            const div = document.createElement('div');
                            div.className = 'no-results px-2 py-1 text-muted small';
                            div.textContent = text;
                            return div;
                        }
                    }
                });
            }

            const selects = {
                origin: createLocationSelect(origin),
                destination: createLocationSelect(destination)
            };

            // --- Tarih çipleri ----------------------------------------------
            function refreshChips() {
                const active = helpers.activeDateChip(date.value, config.today, config.tomorrow);

                for (const [name, button] of Object.entries(chips)) {
                    const isActive = name === active;
                    button.classList.toggle('is-active', isActive);
                    button.setAttribute('aria-pressed', String(isActive));
                }
            }

            for (const button of Object.values(chips)) {
                button.addEventListener('click', function () {
                    date.value = button.dataset.date;
                    refreshChips();
                    showErrors(collectErrors());
                });
            }

            date.addEventListener('change', refreshChips);

            // --- Takas -------------------------------------------------------
            document.getElementById('swap').addEventListener('click', function () {
                const originItem = selects.origin.options[selects.origin.getValue()];
                const destinationItem = selects.destination.options[selects.destination.getValue()];

                if (!originItem || !destinationItem) return;

                // Seçenek karşı alanda mevcut olmayabilir (metin aramasıyla
                // seçilmiş olabilir), bu yüzden önce eklenir.
                selects.origin.addOption(destinationItem);
                selects.destination.addOption(originItem);

                selects.origin.setValue(destinationItem.id, true);
                selects.destination.setValue(originItem.id, true);

                showErrors(collectErrors());
            });

            // --- Son aramanın geri yüklenmesi --------------------------------
            const storage = (function () {
                try {
                    return window.localStorage;
                } catch (error) {
                    // Gizli sekmede veya site verisi kapalıyken erişim
                    // istisna fırlatabilir; form yine çalışmalı.
                    return null;
                }
            })();

            function restoreLastSearch() {
                const saved = helpers.readLastSearch(storage);
                if (!saved) return;

                for (const [field, select] of Object.entries(selects)) {
                    const location = saved[field];
                    if (!location) continue;

                    // Ad da saklanıyor, çünkü kullanıcı varsayılan listede
                    // olmayan bir lokasyon seçmiş olabilir ve seçeneğin
                    // yeniden oluşturulması gerekir.
                    select.addOption({ id: location.id, name: location.name || location.id });
                    select.setValue(location.id, true);
                }

                const clamped = helpers.clampDepartureDate(saved.date, config.today);
                if (clamped.date) {
                    date.value = clamped.date;
                }
                if (clamped.wasClamped) {
                    notice.classList.remove('d-none');
                }
            }

            function persistLastSearch() {
                const originItem = selects.origin.options[selects.origin.getValue()];
                const destinationItem = selects.destination.options[selects.destination.getValue()];

                helpers.writeLastSearch(storage, {
                    origin: originItem
                        ? { id: String(originItem.id), name: originItem.name }
                        : null,
                    destination: destinationItem
                        ? { id: String(destinationItem.id), name: destinationItem.name }
                        : null,
                    date: date.value
                });
            }

            // --- İstemci tarafı ayna doğrulama -------------------------------
            // Anında geri bildirim sağlar, ama bir koruma değildir. Aynı iki
            // kural sunucuda da uygulanıyor, çünkü sefer sayfası doğrudan
            // adresle açılabiliyor ve obilet API'si kuralların hiçbirini
            // güvenilir biçimde uygulamıyor.
            function collectErrors() {
                const errors = [];

                if (origin.value === destination.value) {
                    errors.push(config.messages.sameLocation);
                }
                // Karşılaştırma ISO dizeleri üzerinden; yerel saat diliminde
                // Date nesnesi kurmak gün kaymasına yol açabilir.
                if (date.value && date.value < date.min) {
                    errors.push(config.messages.pastDate);
                }

                return errors;
            }

            function showErrors(errors) {
                summary.innerHTML = '';

                if (errors.length === 0) {
                    summary.classList.add('d-none');
                    return;
                }

                const list = document.createElement('ul');
                list.className = 'mb-0';
                for (const message of errors) {
                    const item = document.createElement('li');
                    item.textContent = message;
                    list.appendChild(item);
                }
                summary.appendChild(list);
                summary.classList.remove('d-none');
            }

            form.addEventListener('submit', function (event) {
                const errors = collectErrors();
                if (errors.length > 0) {
                    event.preventDefault();
                    showErrors(errors);
                    return;
                }

                persistLastSearch();
            });

            for (const field of [origin, destination, date]) {
                field.addEventListener('change', function () {
                    showErrors(collectErrors());
                });
            }

            restoreLastSearch();
            refreshChips();
        })();
    </script>
}
