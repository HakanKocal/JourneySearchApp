<?xml version="1.0" encoding="utf-8"?>
<!--
  Depoya özel paket kaynağı yapılandırması.

  <clear /> makinede tanımlı global kaynakları bu çözüm için devre dışı bırakır
  ve yalnızca nuget.org kullanılır. İki nedeni var:

  1. Bu projenin hiçbir özel (private) beslemeye ihtiyacı yok; tüm paketler
     nuget.org üzerinde herkese açık.
  2. Kimlik doğrulaması gerektiren global bir besleme, kimliği olmayan bir
     makinede restore işlemini 401 ile durdurur. Projeyi klonlayan birinin
     bizim makinemizdeki kimlik bilgilerine sahip olmasını bekleyemeyiz.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
