@using Microsoft.Extensions.Localization
@using Obilet.Web
@model ErrorViewModel
@inject IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Error_Title"].Value;
}

@*
    obilet API'siyle ilgisi olmayan beklenmeyen hatalar için. Şablonla gelen
    hâlinden farkı: geliştirme ortamı ayrıntılarını ve yığın izini
    göstermiyor. Böyle bir sayfa üretimde sızdırılabilir bilgi kaynağıdır.
*@

<div class="container py-5" style="max-width: 560px">
    <div class="field-card text-center py-4">
        <h1 class="h5" style="color: var(--obilet-dark-slate)">@L["Error_Title"]</h1>

        <p class="mb-3">@L["Error_Message"]</p>

        <a asp-controller="Home" asp-action="Index" class="btn btn-obilet">@L["Error_BackHome"]</a>

        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-muted mt-3 mb-0">@L["Error_ReferenceFormat", Model.RequestId!]</p>
        }
    </div>
</div>
