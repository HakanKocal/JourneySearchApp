@using System.Globalization
@using Microsoft.Extensions.Localization
@using Obilet.Web
@inject IStringLocalizer<SharedResource> L
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @L["App_Name"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/obilet.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @*
        Şartnamedeki üst çubuk boş: logo, menü veya metin taşımıyor. Sefer
        sayfası kendi mavi başlığını getirdiği için oradaki çubuğun yerini
        o alır; bu yüzden başlık bir bölüm olarak devredilebilir.
    *@
    @if (IsSectionDefined("Header"))
    {
        @await RenderSectionAsync("Header")
    }
    else
    {
        <header class="obilet-topbar"></header>
    }

    <main role="main">
        @RenderBody()
    </main>

    <footer class="py-3 text-center small text-muted">
        <div>&copy; 2026 &middot; @L["App_Name"]</div>
        <div class="mt-1">
            <partial name="_LanguageSwitcher" />
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
